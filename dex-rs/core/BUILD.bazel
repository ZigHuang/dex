load("//:defs.bzl", "dex_rust_crate")

dex_rust_crate(
    name = "core",
    compile_data = glob(["assets/**"]),
    crate_name = "dex_core",
    crate_srcs = glob(["src/**/*.rs"]) + [
        "//dex-rs/ext/guardian-v2:src/sync_reviewer/reviewer_config.rs",
    ],
    extra_binaries = [
        "//dex-rs/bwrap:bwrap",
        "//dex-rs/code-mode-host:dex-code-mode-host",
        "//dex-rs/linux-sandbox:dex-linux-sandbox",
        "//dex-rs/rmcp-client:test_stdio_server",
        "//dex-rs/rmcp-client:test_streamable_http_server",
        "//dex-rs/cli:dex",
        "//dex-rs/windows-sandbox-rs:dex-command-runner",
        "//dex-rs/windows-sandbox-rs:dex-windows-managed-deny-probe",
        "//dex-rs/windows-sandbox-rs:dex-windows-sandbox-setup",
    ],
    integration_compile_data_extra = glob(["assets/**"]) + [
        "//dex-rs/prompts:templates/permissions/approval_policy/on_request_rule_request_permission.md",
    ],
    integration_test_timeout = "long",
    run_tests_with_wine_exec = True,
    rustc_env = {
        # Keep manifest-root path lookups inside the Bazel execroot for code
        # that relies on env!("CARGO_MANIFEST_DIR").
        "CARGO_MANIFEST_DIR": "dex-rs/core",
    },
    test_data_extra = [
        "config.schema.json",
    ] + glob(["src/**/snapshots/**"]) + [
    ],
    test_shard_counts = {
        "core-all-test": 16,
        "core-unit-tests": 8,
    },
    test_tags = ["no-sandbox"],
    test_threads = select({
        "@platforms//os:macos": 1,
        "//conditions:default": 0,
    }),
    unit_test_srcs = glob([
        "src/**/*_test.rs",
        "src/**/*_tests.rs",
        "src/**/tests.rs",
        "src/**/tests/**/*.rs",
    ]) + [
        "src/apps/render.rs",
        "src/config/schema.rs",
        "src/context/world_state/test_support.rs",
        "src/guardian/test_host.rs",
        "src/plugins/test_support.rs",
    ],
    unit_test_timeout = "long",
)
