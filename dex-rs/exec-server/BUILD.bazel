load("//:defs.bzl", "dex_rust_crate")
load("//bazel/rules/testing/compat:exec_server_compat_test.bzl", "exec_server_compat_test")

exports_files(
    ["src/proto/dex.exec_server.relay.v1.rs"],
    visibility = ["//dex-rs/exec-server/tests/support:__pkg__"],
)

dex_rust_crate(
    name = "exec-server",
    crate_name = "dex_exec_server",
    crate_srcs = glob([
        "src/**/*.rs",
        "tests/unit/**/*.rs",
    ]),
    deps_extra = [
        "@crates//:opentelemetry",
        "@crates//:opentelemetry_sdk",
        "@crates//:toml",
    ],
    extra_binaries = [
        "//dex-rs/bwrap:bwrap",
        "//dex-rs/windows-sandbox-rs:dex-command-runner",
        "//dex-rs/windows-sandbox-rs:dex-windows-sandbox-setup",
    ],
    integration_compile_data_extra = [
        "src/proto/dex.exec_server.relay.v1.rs",
    ],
    # Keep the crate's tests single-threaded under Bazel because they install
    # process-global test-binary dispatch state, and the remote exec-server
    # cases already rely on serialization around the full CLI path.
    integration_test_args = ["--test-threads=1"],
    test_tags = ["no-sandbox"],
    unit_test_args = ["--test-threads=1"],
)

exec_server_compat_test(
    name = "exec-server-current-version-test",
    comparison_binary = "//dex-rs/cli:dex",
    current_binary = "//dex-rs/cli:dex",
)

# Preparation selects both releases; the normal Bazel test invocation runs them.
exec_server_compat_test(
    name = "exec-server-stable-release-test",
    release = "@dex_release_latest_stable",
)

exec_server_compat_test(
    name = "exec-server-historical-release-test",
    release = "@dex_release_historical_stable",
)
