load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "dex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "dex_e2e_benchmark")

dex_rust_crate(
    name = "cli",
    crate_name = "dex_cli",
    extra_binaries = [
        "//dex-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "dex",
)

dex_e2e_benchmark(
    name = "dex-help",
    binaries = [":dex"],
)
